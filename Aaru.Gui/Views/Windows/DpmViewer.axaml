<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:windows="clr-namespace:Aaru.Gui.ViewModels.Windows"
        xmlns:controls="clr-namespace:Aaru.Gui.Controls"
        mc:Ignorable="d"
        Width="1200"
        Height="720"
        d:DesignWidth="1200"
        d:DesignHeight="720"
        x:Class="Aaru.Gui.Views.Windows.DpmViewer"
        x:DataType="windows:DpmViewerViewModel"
        Title="{Binding Title, Mode=OneWay}">
    <Design.DataContext>
        <windows:DpmViewerViewModel />
    </Design.DataContext>
    <Grid RowDefinitions="*,Auto"
          RowSpacing="4"
          Margin="8">
        <controls:DpmPlot Grid.Row="0"
                          x:Name="Plot"
                          Analysis="{Binding Analysis, Mode=OneWay}" />
        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="16">
            <TextBlock Grid.Column="0"
                       Text="{Binding ViewText, Mode=OneWay}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding HoverText, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Window>