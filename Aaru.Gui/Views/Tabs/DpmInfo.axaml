<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tabs="clr-namespace:Aaru.Gui.ViewModels.Tabs"
             xmlns:models="clr-namespace:Aaru.Gui.Models"
             xmlns:localization="clr-namespace:Aaru.Localization;assembly=Aaru.Localization"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="tabs:DpmInfoViewModel"
             x:Class="Aaru.Gui.Views.Tabs.DpmInfo">
    <Design.DataContext>
        <tabs:DpmInfoViewModel />
    </Design.DataContext>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8"
                    Margin="8">
            <ItemsControl ItemsSource="{Binding Summary, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DpmSummaryModel">
                        <Grid ColumnDefinitions="200,*"
                              ColumnSpacing="8"
                              Margin="0,2">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Label, Mode=OneWay}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Value, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Command="{Binding OpenGraphCommand, Mode=OneWay}"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal"
                            Spacing="4">
                    <ic:FluentIcon Icon="DataLine" />
                    <TextBlock Text="{x:Static localization:UI.ButtonLabel_Open_DPM_graph}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>